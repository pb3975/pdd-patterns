(set-logic QF_LIA)
(declare-const spent Int)
(declare-const amount Int)
(declare-const limit Int)
(assert (>= spent 0))
(assert (>= amount 0))
(assert (>= limit spent))
(define-fun contract () Bool (<= amount (- limit spent)))
(define-fun implementation () Bool (<= (+ spent amount) limit))
(assert (not (= implementation contract)))
(check-sat)
