(set-logic QF_LIA)
(declare-const cap Int)
(declare-const value Int)
(assert (>= cap 0))
(assert (>= value 0))
(define-fun clamp ((n Int)) Int (ite (<= n cap) n cap))
(assert (or (> (clamp value) cap)
            (not (= (clamp (clamp value)) (clamp value)))
            (and (<= value cap) (not (= (clamp value) value)))
            (and (> value cap) (not (= (clamp value) cap)))))
(check-sat)
